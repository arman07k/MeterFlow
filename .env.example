# MeterFlow Environment Configuration Template
# Copy to `.env` for local usage. Never commit `.env` or real credentials.

# Active Spring profile: "local" (Docker Compose PostgreSQL) or "supabase" (Shared Supabase PostgreSQL)
SPRING_PROFILES_ACTIVE=local

# Server port
SERVER_PORT=8080

# Local Docker Compose PostgreSQL defaults (used by compose.yaml and "local" profile)
POSTGRES_DB=meterflow
POSTGRES_USER=meterflow
POSTGRES_PASSWORD=meterflow_local_dev_only
LOCAL_DB_URL=jdbc:postgresql://localhost:5432/meterflow

# Shared Supabase PostgreSQL (used ONLY when SPRING_PROFILES_ACTIVE=supabase)
# IMPORTANT: Flyway requires Direct or Supavisor Session Mode (port 5432), never Transaction Mode (6543).
SUPABASE_DB_URL=jdbc:postgresql://aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DB_USERNAME=postgres.your-project-ref
SUPABASE_DB_PASSWORD=replace-with-supabase-password

# Webhook signing secret envelope encryption key (Base64-encoded 256-bit key for AES-256-GCM)
WEBHOOK_SECRET_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key

# Explicit one-time initial administrator bootstrap (disabled by default; never commit real passwords)
# Set METERFLOW_BOOTSTRAP_ADMIN_ENABLED=true only for one-time initial provisioning, then disable.
METERFLOW_BOOTSTRAP_ADMIN_ENABLED=false
METERFLOW_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
METERFLOW_BOOTSTRAP_ADMIN_NAME=Platform Administrator
METERFLOW_BOOTSTRAP_ADMIN_PASSWORD=replace-with-strong-min-12-char-password
